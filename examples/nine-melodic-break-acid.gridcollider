          "scCode": "SynthDef(\\tone, { |out = 0, pitch = 60, amp = 0.22, sustain = 0.20, pan = 0| var freq, env, sweep, sig; freq = pitch.midicps; env = EnvGen.kr(Env.perc(0.001, sustain * 1.25, curve: -6), doneAction: 2); sweep = EnvGen.kr(Env.perc(0.002, sustain * 0.75, 900, curve: -5)); sig = Pulse.ar(freq * [1, 1.005], 0.37).sum * 0.35; sig = RLPF.ar(sig, (freq * 2 + sweep).clip(80, 9000), 0.22) * env * amp; Out.ar(out, Pan2.ar(sig.tanh, pan)); }); SynthDef(\\bass, { |out = 0, pitch = 40, amp = 0.34, sustain = 0.28, pan = 0| var freq, env, sweep, sig; freq = pitch.midicps; env = EnvGen.kr(Env.perc(0.001, sustain * 1.3, curve: -6), doneAction: 2); sweep = EnvGen.kr(Env.perc(0.001, sustain, 720, curve: -7)); sig = Saw.ar(freq * [0.5, 1.0]).sum * 0.38; sig = RLPF.ar(sig, (freq * 2.5 + sweep).clip(60, 7000), 0.22) * env * amp; Out.ar(out, Pan2.ar((sig * 1.8).tanh, pan)); }); SynthDef(\\kick, { |out = 0, pitch = 36, amp = 0.58, sustain = 0.095, pan = 0| var env, fenv, click, sig; env = EnvGen.kr(Env.perc(0.001, sustain, curve: -9), doneAction: 2); fenv = EnvGen.kr(Env([pitch.midicps * 3.2, pitch.midicps * 0.72], [0.032], -7)); click = HPF.ar(WhiteNoise.ar(0.035), 5200) * EnvGen.kr(Env.perc(0.001, 0.012)); sig = (SinOsc.ar(fenv) * env * amp) + click; Out.ar(out, Pan2.ar((sig * 2.2).tanh, pan)); }); SynthDef(\\snare, { |out = 0, pitch = 62, amp = 0.30, sustain = 0.045, pan = 0| var env, body, noise, sig; env = EnvGen.kr(Env.perc(0.001, sustain, curve: -8), doneAction: 2); body = SinOsc.ar(185) * 0.10; noise = BPF.ar(WhiteNoise.ar, 2400, 0.34); sig = (noise + body) * env * amp; Out.ar(out, Pan2.ar((sig * 1.6).tanh, pan)); }); SynthDef(\\hat, { |out = 0, pitch = 86, amp = 0.11, sustain = 0.012, pan = 0| var env, sig; env = EnvGen.kr(Env.perc(0.001, sustain, curve: -10), doneAction: 2); sig = BPF.ar(WhiteNoise.ar, pitch.midicps.max(6800), 0.18) * env * amp; Out.ar(out, Pan2.ar(sig, pan)); }); SynthDef(\\grain, { |out = 0, pitch = 74, amp = 0.13, sustain = 0.12, pan = 0| var freq, env, sig; freq = pitch.midicps; env = EnvGen.kr(Env.perc(0.001, sustain, curve: -5), doneAction: 2); sig = Pulse.ar(freq * LFNoise1.kr(14).range(0.5, 2.01), 0.08) * env * amp; Out.ar(out, Pan2.ar(BPF.ar(sig, freq * 2.4, 0.12), pan)); });",

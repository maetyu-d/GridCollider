          "mixerLevel": 0,
          "mixerPan": 0,
          "scCode": "// Neon Heartbreak local palette. One SC lane can define the whole routed instrument set.\nSynthDef(\\pluck, { |out = 0, pitch = 60, amp = 0.20, sustain = 0.11, pan = 0|\n    var freq = pitch.midicps;\n    var env = EnvGen.kr(Env.perc(0.0008, sustain.max(0.025), curve: -9), doneAction: 2);\n    var snap = BPF.ar(WhiteNoise.ar, (freq * 8.0).clip(1800, 12000), 0.035) * 0.95;\n    var body = SinOsc.ar(freq * 2.0, 0, 0.09);\n    Out.ar(out, Pan2.ar(HPF.ar(snap + body, 600) * env * amp * 2.8, pan));\n});\n\nSynthDef(\\bell, { |out = 0, pitch = 72, amp = 0.16, sustain = 1.85, pan = 0|\n    var freq = pitch.midicps;\n    var env = EnvGen.kr(Env.perc(0.004, sustain.max(0.35), curve: -5), doneAction: 2);\n    var sig = SinOsc.ar(freq * [1, 2.73, 3.91, 5.47], 0, [0.62, 0.30, 0.16, 0.08]).sum;\n    Out.ar(out, Pan2.ar(HPF.ar(sig * env * amp * 2.4, 540), pan));\n});\n\nSynthDef(\\fm, { |out = 0, pitch = 60, amp = 0.15, sustain = 0.46, pan = 0|\n    var freq = pitch.midicps;\n    var env = EnvGen.kr(Env.perc(0.001, sustain.max(0.07), curve: -6), doneAction: 2);\n    var index = EnvGen.kr(Env([7.5, 0.25], [sustain.max(0.07)], curve: -7));\n    var sig = SinOsc.ar((freq * 1.5) + (SinOsc.ar(freq * 3.005) * freq * index));\n    sig = BPF.ar(sig, (freq * 6).clip(700, 8000), 0.34) + (HPF.ar(sig, 900) * 0.30);\n    Out.ar(out, Pan2.ar(sig * env * amp * 2.7, pan));\n});\n\nSynthDef(\\acid, { |out = 0, pitch = 48, amp = 0.11, sustain = 0.18, pan = 0|\n    var freq = pitch.midicps;\n    var env = EnvGen.kr(Env.perc(0.002, sustain.max(0.035), curve: -8), doneAction: 2);\n    var sweep = EnvGen.kr(Env([freq * 18, freq * 2.6], [sustain.max(0.04)], curve: -7));\n    var sig = RLPF.ar(Pulse.ar(freq, 0.18), sweep.clip(420, 9800), 0.09);\n    Out.ar(out, Pan2.ar(HPF.ar(sig * env * amp * 2.2, 145).softclip, pan));\n});\n\nSynthDef(\\hat, { |out = 0, pitch = 84, amp = 0.13, sustain = 0.030, pan = 0|\n    var env = EnvGen.kr(Env.perc(0.0005, sustain.max(0.008), curve: -10), doneAction: 2);\n    var sig = HPF.ar(WhiteNoise.ar, pitch.midicps.max(8500));\n    sig = BPF.ar(sig, pitch.midicps.max(9200), 0.42);\n    Out.ar(out, Pan2.ar(sig * env * amp * 2.4, pan));\n});\n\nSynthDef(\\noise, { |out = 0, pitch = 84, amp = 0.09, sustain = 0.060, pan = 0|\n    var env = EnvGen.kr(Env.perc(0.002, sustain.max(0.014), curve: -8), doneAction: 2);\n    var centre = pitch.midicps.clip(5400, 11800);\n    var sig = BPF.ar(WhiteNoise.ar, centre, 0.16) + (HPF.ar(WhiteNoise.ar, 9200) * 0.18);\n    Out.ar(out, Pan2.ar(sig * env * amp * 2.0, pan));\n});\n\nSynthDef(\\lead, { |out = 0, pitch = 60, amp = 0.15, sustain = 0.58, pan = 0|\n    var freq = pitch.midicps;\n    var env = EnvGen.kr(Env.linen(0.012, sustain.max(0.09), 0.12, curve: -4), doneAction: 2);\n    var sig = VarSaw.ar(freq * [1, 1.004], 0, [0.20, 0.64]).sum * 0.20;\n    sig = RLPF.ar(sig, (freq * 7.2).clip(1300, 9200), 0.20);\n    Out.ar(out, Pan2.ar(sig * env * amp * 2.6, pan));\n});\n",
